{
  "name": "servidor-imagenes-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Servidor y PWA para catálogo de imágenes optimizadas de alta calidad y bajo peso con GitHub y jsDelivr CDN",
  "workspaces": [
    "packages/*",
    "packages/*/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "dev:pwa": "pnpm --filter @catalog/pwa dev",
    "build:pwa": "pnpm --filter @catalog/pwa build",
    "preview:pwa": "pnpm --filter @catalog/pwa preview"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
